# Installed by sol (steps/95-backup.sh). Read by sol-backup.service and sol-check.service.
# Storage credentials do not belong here: put them in /etc/sol/restic-backend.env (chmod 600).
RESTIC_REPOSITORY=@SOL_RESTIC_REPOSITORY@
RESTIC_PASSWORD_FILE=@SOL_RESTIC_PASSWORD_FILE@
RESTIC_CACHE_DIR=/var/cache/restic
