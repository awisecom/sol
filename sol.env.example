# sol.env: settings for bootstrap.sh.
#   cp sol.env.example sol.env && chmod 600 sol.env
# sol.env is git-ignored. Secrets live in separate root-only files that this
# file only points at, so it never holds a password itself.

SOL_HOSTNAME=sol
SOL_USER=admin                 # existing login user (Raspberry Pi Imager creates it)
SOL_TIMEZONE=Europe/Berlin
SOL_LOCALE=en_GB.UTF-8
SOL_WIFI_COUNTRY=DE            # unset country = Wi-Fi radio soft-blocked on Raspberry Pi OS

# SSH. Password logins are only switched off once a key is in place.
SOL_SSH_PUBKEY=""              # e.g. "ssh-ed25519 AAAA... you@laptop"
SOL_SSH_FROM_LAN=yes           # allow SSH over eth0/wlan0 while bringing the box up; "no" once the tailnet works

# Wi-Fi networks as "SSID|password-file|priority". Highest priority wins when several are in range.
SOL_WIFI_NETWORKS=(
  "home-network|/etc/sol/wifi/home.psk|20"
  "phone-hotspot|/etc/sol/wifi/hotspot.psk|10"
)

SOL_EXTRA_PACKAGES=""          # space separated
SOL_AUTO_REBOOT=false          # unattended-upgrades never reboots on its own

# Remote access
SOL_TAILSCALE=yes
SOL_TAILSCALE_AUTHKEY_FILE=""  # optional pre-auth key file; otherwise run `sudo tailscale up` once

# Backups: the step is skipped while the repository is empty.
SOL_RESTIC_REPOSITORY=""       # e.g. "sftp:backup@nas.lan:/srv/restic/sol" or "s3:https://..."
SOL_RESTIC_PASSWORD_FILE=/etc/sol/restic.pass
SOL_BACKUP_PATHS="/etc /home /root"
